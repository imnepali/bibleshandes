[{"id":9142,"book":"Zephaniah","chapter":1,"question":"During which king's reign did Zephaniah prophesy?","answer":"Josiah son of Amon","explanation":"King of Judah.","reference":"Zephaniah 1:1","difficulty":"basic"},{"id":9143,"book":"Zephaniah","chapter":1,"question":"What will God utterly consume?","answer":"All things from off the land","explanation":"A sweeping judgment.","reference":"Zephaniah 1:2","difficulty":"basic"},{"id":9144,"book":"Zephaniah","chapter":1,"question":"What is near and hastens quickly?","answer":"The great day of the LORD","explanation":"The mighty men will cry.","reference":"Zephaniah 1:14","difficulty":"basic"},{"id":9145,"book":"Zephaniah","chapter":1,"question":"What is the people told to do before the Lord?","answer":"Hold their peace","explanation":"The day of the Lord is at hand.","reference":"Zephaniah 1:7-9","difficulty":"basic"},{"id":9146,"book":"Zephaniah","chapter":1,"question":"Which famous king was Zephaniah's ancestor?","answer":"Hizkiah","explanation":"Four generations back.","reference":"Zephaniah 1:1","difficulty":"intermediate"},{"id":9147,"book":"Zephaniah","chapter":1,"question":"What will God cut off from Judah?","answer":"The remnant of Baal","explanation":"And the idolatrous priests.","reference":"Zephaniah 1:4","difficulty":"intermediate"},{"id":9148,"book":"Zephaniah","chapter":1,"question":"How will God search Jerusalem?","answer":"With candles","explanation":"To punish complacent men.","reference":"Zephaniah 1:12","difficulty":"intermediate"},{"id":9149,"book":"Zephaniah","chapter":1,"question":"How is that day described in Zephaniah 1:15?","answer":"A day of wrath, trouble and distress, wasteness and desolation, darkness and gloominess","explanation":"A famous passage.","reference":"Zephaniah 1:15","difficulty":"intermediate"},{"id":9150,"book":"Zephaniah","chapter":1,"question":"By which god do the people swear in Zephaniah 1:5?","answer":"Malcham","explanation":"Alongside the LORD.","reference":"Zephaniah 1:5","difficulty":"advanced"},{"id":9151,"book":"Zephaniah","chapter":1,"question":"What will not deliver them in the day of wrath?","answer":"Their silver and gold","explanation":"The whole land devoured.","reference":"Zephaniah 1:18","difficulty":"advanced"},{"id":9152,"book":"Zephaniah","chapter":2,"question":"Whom does Zephaniah call to seek the LORD?","answer":"All the meek of the earth","explanation":"Seek righteousness and humility.","reference":"Zephaniah 2:3","difficulty":"basic"},{"id":9153,"book":"Zephaniah","chapter":2,"question":"Which Philistine city will be forsaken?","answer":"Gaza","explanation":"And Ashkelon desolate.","reference":"Zephaniah 2:4","difficulty":"basic"},{"id":9154,"book":"Zephaniah","chapter":2,"question":"Which city will God make a desolation?","answer":"Nineveh","explanation":"As dry as the wilderness.","reference":"Zephaniah 2:13","difficulty":"basic"},{"id":9155,"book":"Zephaniah","chapter":2,"question":"What did Nineveh say in her heart?","answer":"\"I am, and there is none beside me\"","explanation":"Pride.","reference":"Zephaniah 2:15","difficulty":"basic"},{"id":9156,"book":"Zephaniah","chapter":2,"question":"What may happen to those who seek the LORD?","answer":"They may be hid in the day of the LORD's anger","explanation":"A hope.","reference":"Zephaniah 2:3-4","difficulty":"intermediate"},{"id":9157,"book":"Zephaniah","chapter":2,"question":"Which peoples reproached God's people?","answer":"Moab and Ammon","explanation":"They boasted.","reference":"Zephaniah 2:8","difficulty":"intermediate"},{"id":9158,"book":"Zephaniah","chapter":2,"question":"What will Moab become like?","answer":"Sodom","explanation":"And Ammon like Gomorrah.","reference":"Zephaniah 2:9","difficulty":"intermediate"},{"id":9159,"book":"Zephaniah","chapter":2,"question":"Which people will be slain by God's sword?","answer":"The Ethiopians","explanation":"Judgment.","reference":"Zephaniah 2:12","difficulty":"intermediate"},{"id":9160,"book":"Zephaniah","chapter":2,"question":"What will God reduce to nothing?","answer":"All the gods of the earth","explanation":"People will worship Him.","reference":"Zephaniah 2:11","difficulty":"advanced"},{"id":9161,"book":"Zephaniah","chapter":2,"question":"What will lodge on Nineveh's capitals?","answer":"The cormorant and the bittern","explanation":"Desolation.","reference":"Zephaniah 2:14","difficulty":"advanced"},{"id":9162,"book":"Zephaniah","chapter":3,"question":"What will God do over His people with gladness?","answer":"Rejoice over them","explanation":"And quiet them with His love.","reference":"Zephaniah 3:17-18","difficulty":"basic"},{"id":9163,"book":"Zephaniah","chapter":3,"question":"What will God do over His people with singing?","answer":"Rejoice over them with singing","explanation":"A tender image.","reference":"Zephaniah 3:17-18","difficulty":"basic"},{"id":9164,"book":"Zephaniah","chapter":3,"question":"What will God give the peoples?","answer":"A pure language","explanation":"That they may call on His name.","reference":"Zephaniah 3:9","difficulty":"basic"},{"id":9165,"book":"Zephaniah","chapter":3,"question":"Who is told to sing in Zephaniah 3:14?","answer":"The daughter of Zion","explanation":"Rejoice with all your heart.","reference":"Zephaniah 3:14","difficulty":"basic"},{"id":9166,"book":"Zephaniah","chapter":3,"question":"What does Zephaniah call Jerusalem?","answer":"Filthy, polluted, the oppressing city","explanation":"A woe.","reference":"Zephaniah 3:1","difficulty":"intermediate"},{"id":9167,"book":"Zephaniah","chapter":3,"question":"To what are Jerusalem's princes compared?","answer":"Roaring lions","explanation":"And judges like evening wolves.","reference":"Zephaniah 3:3","difficulty":"intermediate"},{"id":9168,"book":"Zephaniah","chapter":3,"question":"Whom will God leave in Jerusalem?","answer":"An afflicted and poor people","explanation":"They will trust in His name.","reference":"Zephaniah 3:12","difficulty":"intermediate"},{"id":9169,"book":"Zephaniah","chapter":3,"question":"Who is in the midst of Zion?","answer":"The King of Israel, the LORD","explanation":"You shall see disaster no more.","reference":"Zephaniah 3:15","difficulty":"intermediate"},{"id":9170,"book":"Zephaniah","chapter":3,"question":"From beyond which rivers will worshippers come?","answer":"The rivers of Ethiopia","explanation":"Bringing offerings.","reference":"Zephaniah 3:10","difficulty":"advanced"},{"id":9171,"book":"Zephaniah","chapter":3,"question":"What will God give His people among all peoples?","answer":"A name and a praise","explanation":"When He returns their captives.","reference":"Zephaniah 3:20","difficulty":"advanced"}]